# ============================================================
# VidSMM — Docker Compose environment
# Copy this file to `.env` (repo root, next to docker-compose.yml).
# Every variable has a sensible local default; set the real
# values before going to production.
# ============================================================

# ---- Secrets (REQUIRED to change in production — min 16 chars) ----
CUSTOMER_JWT_SECRET=change-me-customer-jwt-secret-32-char-min
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-32-char-min

# ---- Google OAuth (customer sign-in) ----
# Leave empty to run with sign-in disabled (backend warns on boot).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud Console.
FRONTEND_URL=http://localhost:5173

# ---- Admin bootstrap ----
# Set both to auto-create the first super admin on boot.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- SMM provider (smmwiz | mock) ----
SMM_PROVIDER=mock
SMMWIZ_API_KEY=

# ---- Payment provider (mock | cutluy | abapayway) ----
PAYMENT_PROVIDER=mock
CUTLUY_API_KEY=
CUTLUY_WEBHOOK_SECRET=

# ---- Optional overrides ----
# By default the backend uses the in-compose MongoDB + Redis.
# Point MONGODB_URI at MongoDB Atlas if you prefer:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vidsmm
# MONGODB_URI=mongodb://mongo:27017/vidsmm
# REDIS_URL=redis://redis:6379
ENABLE_ORDER_SYNC_JOB=false
