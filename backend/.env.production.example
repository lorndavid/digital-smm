# ============================================================
# DigitalSMM — PRODUCTION backend environment (Docker)
#
# Copy to backend/.env on the VPS, fill in REAL values, then:
#   chmod 600 backend/.env
# Every name below is read by backend/src/config/env.ts — don't
# add random variables; the backend ignores anything extra.
# ============================================================

NODE_ENV=production
PORT=4000

# --- MongoDB Atlas (REQUIRED) ---
# Add your VPS public IP in Atlas → Security → Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digitalsmm?retryWrites=true&w=majority
# Optional: pin DNS servers if Atlas SRV lookups fail on your ISP/VPS
# (e.g. '1.1.1.1,8.8.8.8'). Leave empty to use the system resolver.
DNS_SERVERS=

# --- Customer Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirects the customer back to ${FRONTEND_URL}/auth/callback
FRONTEND_URL=https://digitalsmm.shop
# Session JWT (generate with: openssl rand -hex 32)
CUSTOMER_JWT_SECRET=
CUSTOMER_JWT_EXPIRES_IN=7d

# --- Admin auth + first super admin ---
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=12h
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- CORS (exact origins, no trailing slashes, no *) ---
# Include BOTH the apex and www — Vercel serves the site on either host,
# and a browser on www.digitalsmm.shop sends Origin: https://www.digitalsmm.shop.
CORS_ORIGINS=https://digitalsmm.shop,https://www.digitalsmm.shop,https://admin.digitalsmm.shop

# --- SMM provider (smmwiz | mock) ---
SMM_PROVIDER=smmwiz
# The live API domain is wizsmm.com — smmwiz.com is dead and rejects keys.
SMMWIZ_API_URL=https://wizsmm.com/api/v2
SMMWIZ_API_KEY=

# --- Payment provider (cutluy | mock | abapayway) ---
PAYMENT_PROVIDER=cutluy
CUTLUY_API_URL=https://cutluy.com/v1
CUTLUY_API_KEY=
# MUST match the secret in the CutLuy dashboard webhook settings.
CUTLUY_WEBHOOK_SECRET=

# --- Optional: ABA PayWay (only if PAYMENT_PROVIDER=abapayway) ---
# ABAPAYWAY_MERCHANT_ID=
# ABAPAYWAY_API_KEY=
# ABAPAYWAY_RETURN_URL=https://digitalsmm.shop/dashboard/wallet

# --- Sentry (recommended) ---
# https://sentry.io → create a Node.js project → copy the DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Redis (leave empty — single instance uses in-memory) ---
# Only set REDIS_URL when running MULTIPLE backend replicas behind a load
# balancer (distributed SSE + rate limits). On your 2 GB VPS: leave empty.
REDIS_URL=

# --- Background jobs ---
ENABLE_ORDER_SYNC_JOB=true
ORDER_SYNC_INTERVAL_MS=15000

# --- Rate limits (defaults are fine) ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=3000
# RATE_LIMIT_CATALOGUE_MAX=10000
