# ============================================
# VidSMM Backend Environment Variables
# Copy to .env and fill in real values.
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- MongoDB Atlas (required) ----
# Create a free cluster at https://www.mongodb.com/atlas
# then copy the connection string, e.g.:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vidsmm
MONGODB_URI=

# ---- DNS (optional) ----
# Fixes `querySrv ECONNREFUSED` on Windows/ISP networks where Node's resolver
# (c-ares) fails SRV lookups even though nslookup works. Comma-separated.
# Leave empty to use the system resolver.
DNS_SERVERS=1.1.1.1,8.8.8.8

# ---- Customer auth: Google OAuth 2.0 (Google sign-in) ----
# 1. Google Cloud Console → APIs & Services → Credentials → Create credentials
#    → OAuth client ID → Web application.
# 2. Add the Authorized redirect URI: <FRONTEND_URL>/auth/callback
# 3. Enable the scopes: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend origin Google redirects the customer back to after consent.
FRONTEND_URL=http://localhost:5173
# Signs customer session JWTs (HS256). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_JWT_SECRET=change-me-to-a-random-32-byte-secret
CUSTOMER_JWT_EXPIRES_IN=7d
# Public Google endpoints (defaults are fine).
# GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
# OAuth state tokens expire after this many seconds.
# OAUTH_STATE_TTL_SECONDS=600

# ---- Admin auth (email + password, stored in MongoDB) ----
# Secret used to sign admin session JWTs (HS256). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=change-me-to-a-random-32-byte-secret
ADMIN_JWT_EXPIRES_IN=12h
# Optional: auto-create the first super admin on boot (email + password).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---- CORS ----
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- SMM Provider (smmwiz | mock) ----
SMM_PROVIDER=mock
SMMWIZ_API_URL=https://smmwiz.com/api/v2
# Get your smmwiz key at https://smmwiz.com/ (Account page)
SMMWIZ_API_KEY=

# ---- Payment Provider (mock | cutluy | abapayway) ----
# mock = local KHQR demo (no key). cutluy = real Bakong KHQR. abapayway = ABA.
PAYMENT_PROVIDER=mock

# ---- CutLuy (real Bakong KHQR) ----
# https://cutluy.com → Dashboard → API keys / Webhooks
CUTLUY_API_URL=https://cutluy.com/v1
# Required to enable the provider (payment creation + status polling).
CUTLUY_API_KEY=
# Required ONLY for webhook verification (Dashboard → Webhooks → signing
# secret). Without it, incoming webhooks are rejected (fail closed);
# payment creation and polling still work with the API key alone.
CUTLUY_WEBHOOK_SECRET=

# ---- ABA PayWay (optional second provider) ----
ABAPAYWAY_API_URL=https://checkout.payway.com.kh/api/payment-gateway/v1/payments
ABAPAYWAY_MERCHANT_ID=
ABAPAYWAY_API_KEY=
ABAPAYWAY_RETURN_URL=http://localhost:5173/dashboard/wallet

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Background jobs ----
# Polls provider order status and syncs the database.
ENABLE_ORDER_SYNC_JOB=false
ORDER_SYNC_INTERVAL_MS=60000

# ---- Redis (optional) ----
# Enables cross-instance payment SSE delivery AND a distributed rate
# limiter (global quotas shared across all backend instances) when running
# multiple instances behind a load balancer. Leave empty for in-memory mode
# (single instance / local dev).
# Example: redis://localhost:6379
REDIS_URL=
