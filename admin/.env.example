# ============================================
# DigitalSMM Admin Panel — Environment
# Copy to .env and fill in real values.
#
# Everything here is PUBLIC — Vite inlines VITE_* variables into the
# browser bundle. NEVER put secrets in this file.
# ============================================

# Backend API base URL. In development Vite proxies /api to the backend,
# so this stays "/api". For production set your deployed backend origin.
VITE_API_BASE_URL=/api

# App environment tag — "development" | "staging" | "production".
# Drives Sentry environment labels.
VITE_APP_ENV=development

# Sentry DSN for the admin panel. The project DSN is baked into the bundle
# by default; set this only to override it per environment.
# (DSNs are public — they must be sent to the browser — never put secrets here.)
VITE_SENTRY_DSN=
