# ============================================
# DigitalSMM Customer Frontend — Environment
# Copy to .env and fill in real values.
#
# Everything here is PUBLIC — Vite inlines VITE_* variables into the
# browser bundle. NEVER put secrets in this file.
# ============================================

# Backend API base URL. In development Vite proxies /api to the backend,
# so this stays "/api". For production set your deployed backend origin,
# e.g. https://api.digitalsmm.shop (with or without a trailing /api —
# the client appends /api automatically when missing).
VITE_API_BASE_URL=/api

# App environment tag — "development" | "staging" | "production".
# Drives analytics/Sentry environment labels and debug toggles.
VITE_APP_ENV=development

# Google Analytics 4 Measurement ID (public, safe to expose), e.g. G-XXXXXXXXXX.
# Leave empty to disable analytics entirely (the app keeps working).
VITE_GA_MEASUREMENT_ID=

# Sentry DSN for the customer frontend. Leave empty to disable Sentry.
VITE_SENTRY_DSN=
