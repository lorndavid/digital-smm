# Copy to .env and fill in real values.

# Clerk Publishable Key (Clerk Dashboard > API Keys > Quick Copy)
# Required for authentication to work.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend API base URL. In development Vite proxies /api to the backend,
# so this stays "/api". For production set your deployed backend URL.
VITE_API_BASE_URL=/api
